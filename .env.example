# 模型服务：任何 OpenAI 兼容接口。现在用 DeepSeek，最终换成 vLLM 上的 Nemotron 3.5 Lightning 只改这几行
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=<your-deepseek-api-key>
LLM_MODEL=deepseek-flash
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=8192
# vLLM + Nemotron 时可以打开：LLM_ENABLE_THINKING=true
# LLM_BASE_URL=http://<TS_IP>:8000/v1
# LLM_MODEL=nemotron-3.5-lightning

# hub：orchestrator 监听的地址，部门 Agent 默认连这里
HUB_HOST=127.0.0.1
HUB_PORT=8800
TASK_TIMEOUT_SECONDS=600

LOG_LEVEL=INFO

# Default: macOS=seatbelt, Windows/WSL/Linux=docker. Leave unset for automatic selection.
# SKILL_SANDBOX_BACKEND=docker
SKILL_SANDBOX_IMAGE=retail-bash:xyz-1
